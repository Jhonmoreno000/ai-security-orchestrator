# Configuración General
PROJECT_NAME="AI Security Orchestrator"
ENVIRONMENT=development

# Base de datos (PostgreSQL)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=orchestrator_db
POSTGRES_USER=orchestrator_user
POSTGRES_PASSWORD=orchestrator_pass_secure

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Configuración de Seguridad y Tiempos Limite
JOB_TIMEOUT=300
MAX_CONCURRENCY=2

# AI / Ollama Configuration
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=codellama
PRIVACY_MODE=local
